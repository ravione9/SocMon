# Multi-stage prod build that mirrors server/Dockerfile.prod.
# Builder stage installs prod-only deps; final stage copies them into a slim runtime.
FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ARG NPM_STRICT_SSL=true

ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

COPY package.json package-lock.json ./
RUN if [ "$NPM_STRICT_SSL" = "false" ]; then npm config set strict-ssl false; fi \
  && npm ci --omit=dev --no-audit --no-fund --progress=false

FROM node:22-bookworm-slim
WORKDIR /app

# ca-certificates only — MCP doesn't reload nginx so no docker.io needed (unlike server/Dockerfile.prod).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
EXPOSE 5050
CMD ["node", "src/index.js"]
