NODE_ENV=development
PORT=5000
JWT_SECRET=your_secret_here
# Portal login session length (default 7d)
# JWT_EXPIRES_IN=7d
# Default expiry for user-generated API JWTs (Admin must enable API access per user)
# JWT_API_EXPIRES_IN=90d

# ── SSL / HTTPS ────────────────────────────────────────────────────────────────
# Directory where netpulse.crt and netpulse.key will be stored (must be writable
# by the server container and readable by the nginx container via a shared volume).
# CERTS_DIR=/app/certs
# Override individual filenames if needed:
# SSL_CERT_FILE=netpulse.crt
# SSL_KEY_FILE=netpulse.key
# Docker container name of the nginx sidecar — used by `POST /api/ssl/reload`
# to run `nginx -s reload` without restarting the container.
# NGINX_CONTAINER=netpulse-nginx
# Shared nginx config file (prod compose mounts this into server + nginx)
# NGINX_CONF_PATH=/app/nginx/default.conf
# Optional: 64 hex characters (32 bytes) for AES-256-GCM when encrypting per-user device passwords (DeviceUserCredential). If unset, a key is derived from JWT_SECRET.
# DEVICE_CREDENTIALS_KEY=
MONGO_URI=mongodb://admin:netpulse_dev@mongo:27017/netpulse?authSource=admin
REDIS_URL=redis://:netpulse_dev@redis:6379
ES_HOST=https://192.168.24.180:9200
ES_USER=elastic
ES_PASSWORD=your_es_password
# SentinelOne / XDR documents (optional)
ES_SENTINEL_INDEX=sentinel-*
ES_CA_CERT_PATH=./certs/elasticsearch-ca.pem
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://ollama:11434
# External / downstream agents (Cursor, n8n, second LLM) — POST /api/agent/*
# Long random secret; send as X-Netpulse-Agent-Key or Authorization: Bearer <key>
# NETPULSE_AGENT_API_KEY=
# Or comma-separated keys for rotation:
# NETPULSE_AGENT_API_KEYS=key1,key2
# Active NetPulse user whose allowedPages define what context the agent may read:
# NETPULSE_AGENT_USER_EMAIL=agent-service@example.com
# NETPULSE_AGENT_USER_ID=
# Optional default webhook(s) for POST /api/agent/forward and /api/agent/deliver
# NETPULSE_AGENT_FORWARD_URL=https://your-other-agent.example/hooks/netpulse
# NETPULSE_AGENT_FORWARD_URLS=https://agent-a/hook,https://agent-b/hook
# NETPULSE_AGENT_FORWARD_SECRET=shared-secret-for-downstream
# NETPULSE_AGENT_FORWARD_TIMEOUT_MS=30000
# AI_LLM_TIMEOUT_MS=120000
# Model tag from `ollama list` on the Ollama server (e.g. llama3.1:8b, mistral:7b)
OLLAMA_MODEL=llama3.1:8b
# Timestamps in AI / portal replies (default Asia/Kolkata IST)
# PORTAL_TIMEZONE=Asia/Kolkata
# Comma-separated for multiple frontends. If you list only localhost:3000 or only 127.0.0.1:3000, the server adds the other loopback automatically.
CORS_ORIGIN=http://localhost:3000

# Email simulation (/email-sim): URLs embedded in outbound HTML (tracking pixel, links, landing/capture).
# Set when recipients must hit a different host than your browser session (Docker publish, reverse proxy).
# EMAIL_SIM_PUBLIC_ORIGIN=http://localhost:5000
# Optional alias — base URL of the Netpulse API as reachable by recipients:
# PUBLIC_APP_URL=http://localhost:5000

# Browser RDP (Apache Guacamole): Netpulse connects to guacd; the browser only talks to Netpulse over WebSocket.
# Docker Compose sets GUACD_HOST=guacd automatically. For a bare-metal server: GUACD_HOST=127.0.0.1 (default).
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822
# Guacamole RDP resize negotiation: none (safest; avoids disconnect on some hosts) | reconnect | display-update
# RDP_RESIZE_METHOD=none

# SentinelOne Management API (direct console REST — token never exposed to browser)
# Console origin only, e.g. https://your-tenant.sentinelone.net — OR full API root (…/web/api/v2.1); path is normalized.
SENTINEL_ONE_BASE_URL=
SENTINEL_ONE_API_TOKEN=
# Or mount a secret file (recommended if token contains `$` — avoids Compose mangling):
# SENTINEL_ONE_API_TOKEN_FILE=/run/secrets/sentinel_one_api_token
# Generate in SentinelOne: Settings → Users → select user or Service User → API Token (shown once).
# Aliases (either pair works): SENTINELONE_API_BASE_URL + SENTINELONE_API_TOKEN
# Optional auth scheme if auto-detection fails: bearer | apitoken
# SENTINEL_ONE_AUTH_SCHEME=
# TLS: corporate SSL inspection / custom CA — prefer NODE_EXTRA_CA_CERTS=/path/to/ca.pem on the server process.
# Testing only — disables TLS verification for SentinelOne outbound calls only:
# SENTINEL_ONE_TLS_INSECURE=1
# Token diagnostics (token length / JWT shape / whether `$` present — never full secret): set on server then GET /api/sentinel-one/meta
# SENTINEL_ONE_DEBUG_META=1
# SentinelOne Singularity Data Lake (XDR) — PowerQuery API powers the new "XDR query data search" tab.
# Use the XDR regional host (DIFFERENT from the Management Console host above).
# Example (Asia Pacific Southeast 1): https://xdr.ap1.sentinelone.net  · EU: https://xdr.eu1.sentinelone.net  · US: https://xdr.us1.sentinelone.net
# SENTINEL_ONE_XDR_BASE_URL=https://xdr.ap1.sentinelone.net
# Optional separate token with the "Log Read Access" role. If unset, falls back to SENTINEL_ONE_API_TOKEN.
# SENTINEL_ONE_XDR_API_TOKEN=

# Zabbix (Infra Monitoring) — API token (Administration → API tokens)
# Full JSON-RPC URL (404 = wrong path — try /zabbix/api_jsonrpc.php)
ZABBIX_URL=http://192.168.24.188/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=
# Or ZABBIX_TOKEN= (alias)
# auto | bearer | body — use bearer for Zabbix 7.4+
#ZABBIX_AUTH=auto
# ZABBIX_TLS_INSECURE=1

# Store Zabbix (/store-zabbix page) — second Zabbix server (API token from Administration → API tokens)
# Example: http://172.20.11.197/zabbix/api_jsonrpc.php  (no double slash after the IP)
# STORE_ZABBIX_URL=http://172.20.11.197/zabbix/api_jsonrpc.php
# STORE_ZABBIX_API_TOKEN=
# Or STORE_ZABBIX_TOKEN= (alias)
# auto | bearer | body — use bearer for Zabbix 7.4+
#STORE_ZABBIX_AUTH=auto
# STORE_ZABBIX_TLS_INSECURE=1
# If Zabbix is reachable from your PC but Store Zabbix times out in Docker, the container cannot route to that LAN/VPN IP.
# Fix A (easiest dev): run the API on the host — cd server && npm run dev (keep mongo/redis in Docker).
# Fix B (stay in Docker on Windows): port-forward on the host, then point Netpulse at host.docker.internal:
#   netsh interface portproxy add v4tov4 listenaddress=127.0.0.1 listenport=17880 connectaddress=172.20.11.197 connectport=80
#   STORE_ZABBIX_URL=http://host.docker.internal:17880/zabbix/api_jsonrpc.php

# Store Network Monitor (/store-monitor) — InfluxDB from store-monitor.ps1 PowerShell agents
# INFLUX_URL=http://influx-store.itinfralenskart.com:8086
# INFLUX_TOKEN=
# INFLUX_ORG=lenskart
# INFLUX_BUCKET=store-monitoring
# INFLUX_TLS_INSECURE=1

# SolarWinds Orion (/solarwinds page) — credentials stay on the server; users never log in to Orion in the browser.
# Web console (iframe proxy). Default matches common Orion NGUI port.
ORION_WEB_URL=http://192.168.10.100:8787
ORION_USERNAME=
ORION_PASSWORD=
# For AD/LDAP accounts use DOMAIN\user (or set ORION_DOMAIN=LAB and ORION_USERNAME=svc_orion)
# ORION_DOMAIN=
# SWIS REST API (filters / SWQL). Default tries https://<host>:17774 then :17778
ORION_SWIS_URL=https://192.168.10.100:17774/SolarWinds/InformationService/v3/Json
ORION_TLS_INSECURE=true
# Per-request timeout when probing Orion/SWIS from the API (ms). Default 8000.
# ORION_REQUEST_TIMEOUT_MS=8000
# Longer budget for multi-query Reports tab (ms). Default 90000.
# ORION_REPORT_TIMEOUT_MS=90000
# Comma-separated node custom property columns (auto-probed if omitted). Example:
# ORION_NODE_CUSTOM_PROPERTIES=Department,City,State,AssetTag,Interface1,Interface2

# Oracle IDCS (SOC — IDCS Users page). Without these, GET /api/idcs/* returns 503 with a clear message.
# Use your tenancy base URL (no trailing slash), e.g. https://identity.oraclecloud.com
# IDCS_TENANT_URL=
# From IDCS Confidential Application (client_credentials):
# IDCS_CLIENT_ID=
# IDCS_CLIENT_SECRET=
# Corporate SSL inspection / untrusted CA in Docker (same pattern as SENTINEL_ONE_TLS_INSECURE):
# IDCS_TLS_INSECURE=1

# Active Directory — direct integration (/ad management page).
# Configure with DNS domain name + domain controller host (no LDAP distinguished-name paths like DC=...,DC=... in env).
# Required together for “connected” status (unless you use legacy AD_LDAP_URL instead):
# AD_DOMAIN=corp.example.com
# AD_DOMAIN_CONTROLLER=dc01.corp.example.com
# Optional alias for domain DNS name:
# AD_DOMAIN_FQDN=
# Optional NetBIOS short name for UI badges:
# AD_DOMAIN_NETBIOS=CORP
# Service account (UPN user@corp.example.com or DOMAIN\\user — do not commit real secrets):
# AD_SERVICE_USERNAME=
# AD_SERVICE_PASSWORD=
# Legacy optional override if you already expose a full URL elsewhere:
# AD_LDAP_URL=
# LDAP/LDAPS to the DC (required for dashboard counts via /api/ad/stats):
# ldap:// port 389: StartTLS runs automatically before bind unless AD_STARTTLS=0.
# Do NOT set AD_STARTTLS=0 unless you have a rare domain that allows unsigned LDAP — otherwise you get Strong Auth / Unavailable errors.
# AD_STARTTLS=0
# Prefer LDAPS if StartTLS is blocked:
# AD_USE_LDAPS=1
# AD_LDAP_PORT=636
# AD_TLS_INSECURE=1
# tls.connect(servername) for DC certs whose SAN differs from host — optional override:
# AD_TLS_SERVERNAME=dc01.corp.example.com
# Older DCs (Win2008R2/2012, default schannel) negotiate only TLS 1.0/1.1 with legacy ciphers.
# AD_TLS_INSECURE=1 already relaxes both to TLSv1+ and DEFAULT:@SECLEVEL=0; override manually if needed:
# AD_TLS_MIN_VERSION=TLSv1
# AD_TLS_MAX_VERSION=TLSv1.3
# AD_TLS_CIPHERS=DEFAULT:@SECLEVEL=0
# LDAP writes from Netpulse (password reset, unlock, enable/disable, attribute patch). Set to 0|false|off to block all modifies.
# AD_LDAP_WRITES=0
#
# Portal login: admins can create users with authKind "ad" (Admin → Users). Those accounts sign in with the same LDAP identity + domain password as AD management uses above — still requires a Mongo user row with roles/pages (directory membership alone does not grant portal access).

# Optional tuning: AD_STATS_PAGE_SIZE=500   AD_SEARCH_TIME_LIMIT_SEC=180   AD_CLIENT_TIMEOUT_MS=120000

# Nexs / Lenskart Auth Service (user management page at /nexs).
# Admins sign in on the page with username/password; JWT is fetched per session via POST /v1/user/login.
# Swagger: https://lk-authservice-prod-eks.lenskart.com/swagger-ui.html
# NEXS_AUTH_BASE_URL=https://lk-authservice-prod-eks.lenskart.com
# NEXS_APP_ID=nexs_search   # X-Lenskart-App-Id header (login + API calls)
# NEXS_APP_NAME=nexs_search # path key for GET /v1/app/users/{appName}
# NEXS_ROLES_APP_NAME=nexs_search  # body for POST /v1/get/roles (defaults to NEXS_APP_NAME / nexs_search)
# NEXS_PORTAL_APP_ID=nexs_search
# NEXS_APP_NAME=        # for GET /v1/app/users/{appName} and POST /v1/get/roles
# NEXS_AUTH_TOKEN=      # optional static fallback; page login is preferred
# NEXS_PORTAL_URL=https://app.nexs.lenskart.com/usermanagement/roles
# NEXS_PORTAL_ORIGIN=https://app.nexs.lenskart.com
# NEXS_PORTAL_APP_ID=nexs_search
# NEXS_DEBUG_RESPONSE=1
