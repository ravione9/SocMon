NODE_ENV=development
PORT=5000
JWT_SECRET=your_secret_here
# Optional: 64 hex characters (32 bytes) for AES-256-GCM when encrypting per-user device passwords (DeviceUserCredential). If unset, a key is derived from JWT_SECRET.
# DEVICE_CREDENTIALS_KEY=
MONGO_URI=mongodb://admin:netpulse_dev@mongo:27017/netpulse?authSource=admin
REDIS_URL=redis://:netpulse_dev@redis:6379
ES_HOST=https://192.168.24.180:9200
ES_USER=elastic
ES_PASSWORD=your_es_password
# SentinelOne / XDR documents (optional)
ES_SENTINEL_INDEX=sentinel-*
ES_CA_CERT_PATH=./certs/elasticsearch-ca.pem
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://ollama:11434
# Comma-separated for multiple frontends. If you list only localhost:3000 or only 127.0.0.1:3000, the server adds the other loopback automatically.
CORS_ORIGIN=http://localhost:3000

# Browser RDP (Apache Guacamole): Netpulse connects to guacd; the browser only talks to Netpulse over WebSocket.
# Docker Compose sets GUACD_HOST=guacd automatically. For a bare-metal server: GUACD_HOST=127.0.0.1 (default).
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822
# Guacamole RDP resize negotiation: none (safest; avoids disconnect on some hosts) | reconnect | display-update
# RDP_RESIZE_METHOD=none

# SentinelOne Management API (direct console REST — token never exposed to browser)
# Console origin only, e.g. https://your-tenant.sentinelone.net — OR full API root (…/web/api/v2.1); path is normalized.
SENTINEL_ONE_BASE_URL=
SENTINEL_ONE_API_TOKEN=
# Or mount a secret file (recommended if token contains `$` — avoids Compose mangling):
# SENTINEL_ONE_API_TOKEN_FILE=/run/secrets/sentinel_one_api_token
# Generate in SentinelOne: Settings → Users → select user or Service User → API Token (shown once).
# Aliases (either pair works): SENTINELONE_API_BASE_URL + SENTINELONE_API_TOKEN
# Optional auth scheme if auto-detection fails: bearer | apitoken
# SENTINEL_ONE_AUTH_SCHEME=
# TLS: corporate SSL inspection / custom CA — prefer NODE_EXTRA_CA_CERTS=/path/to/ca.pem on the server process.
# Testing only — disables TLS verification for SentinelOne outbound calls only:
# SENTINEL_ONE_TLS_INSECURE=1
# Token diagnostics (token length / JWT shape / whether `$` present — never full secret): set on server then GET /api/sentinel-one/meta
# SENTINEL_ONE_DEBUG_META=1

# Zabbix (Infra Monitoring) — API token (Administration → API tokens)
# Full JSON-RPC URL (404 = wrong path — try /zabbix/api_jsonrpc.php)
ZABBIX_URL=http://192.168.24.188/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=
# Or ZABBIX_TOKEN= (alias)
# auto | bearer | body — use bearer for Zabbix 7.4+
#ZABBIX_AUTH=auto
# ZABBIX_TLS_INSECURE=1

# Oracle IDCS (SOC — IDCS Users page). Without these, GET /api/idcs/* returns 503 with a clear message.
# Use your tenancy base URL (no trailing slash), e.g. https://identity.oraclecloud.com
# IDCS_TENANT_URL=
# From IDCS Confidential Application (client_credentials):
# IDCS_CLIENT_ID=
# IDCS_CLIENT_SECRET=
